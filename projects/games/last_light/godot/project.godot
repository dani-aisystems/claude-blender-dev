; Engine configuration file.
; THE LAST LIGHT (Godot 4.7, Forward+). Input actions are registered in code (scripts/core/input_setup.gd).

config_version=5

[application]

config/name="The Last Light"
config/description="Keep the light. Guide the ships home through the storm."
run/main_scene="res://scenes/main_fp.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/icon.png"
config/macos_native_icon="res://assets/branding/icon.icns"
boot_splash/bg_color=Color(0.024, 0.04, 0.05, 1)
boot_splash/image="res://assets/branding/keyart.png"
boot_splash/use_filter=true

[autoload]

GameState="*res://scripts/game_state.gd"
Settings="*res://scripts/settings.gd"
SaveSystem="*res://scripts/save_system.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)
