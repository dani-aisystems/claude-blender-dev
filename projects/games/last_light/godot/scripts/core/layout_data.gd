class_name LayoutData
extends RefCounted
## Parsed assets/data/layout.json (generated by blender/layout_export.py from spec.py).

const DEFAULT_PATH := "res://assets/data/layout.json"

var island_radius := 20.0
var spawn_radius := 170.0
var spawn_arc := Vector2(-80.0, 80.0)          # degrees
var reefs: Array[Dictionary] = []              # {pos: Vector2, r, kind, variant, rot, height}
var channels: Array[Dictionary] = []           # {bearing (rad), exit, routes: {side: PackedVector2Array}}


static func load_file(path: String = DEFAULT_PATH) -> LayoutData:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_error("layout: cannot open %s" % path)
		return null
	return from_dict(JSON.parse_string(f.get_as_text()))


static func from_dict(d: Dictionary) -> LayoutData:
	var L := LayoutData.new()
	L.island_radius = float(d["island"]["radius"])
	L.spawn_radius = float(d["spawn"]["radius"])
	L.spawn_arc = Vector2(d["spawn"]["arc_deg"][0], d["spawn"]["arc_deg"][1])
	for r in d["reefs"]:
		L.reefs.append({
			"pos": Vector2(r["x"], r["z"]), "r": float(r["r"]), "kind": r["kind"],
			"variant": int(r.get("variant", 0)), "rot": float(r.get("rot", 0.0)),
			"height": float(r.get("height", 1.0)),
		})
	for c in d["channels"]:
		var routes := {}
		for side in c["routes"]:
			var pts := PackedVector2Array()
			for p in c["routes"][side]:
				pts.append(Vector2(p[0], p[1]))
			routes[side] = pts
		L.channels.append({"bearing": deg_to_rad(c["bearing"]), "exit": c["exit"], "routes": routes})
	return L


## Channel whose bearing is closest to the given bearing (radians).
func nearest_channel(bearing: float) -> Dictionary:
	var best: Dictionary = channels[0]
	for c in channels:
		if absf(Geo.angle_diff(bearing, c["bearing"])) < absf(Geo.angle_diff(bearing, best["bearing"])):
			best = c
	return best


func route_for(bearing: float) -> PackedVector2Array:
	var c := nearest_channel(bearing)
	var side: String = c["exit"]
	if side == "auto":
		side = "east" if bearing >= 0.0 else "west"
	return c["routes"][side]
